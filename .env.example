APP_SECRET=replace-with-random-secret-at-least-32-chars
LOCAL_DATABASE_URL=sqlite:.data/local.sqlite
LOCAL_SUPERADMIN_PASSWORD=replace-with-strong-admin-password
PUBLIC_BASE_URL=http://127.0.0.1:3000
STAMP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LOCAL_DB_POOL_MAX=30

# Docker/PostgreSQL mode:
# POSTGRES_PASSWORD=replace-with-strong-postgres-password
# LOCAL_DATABASE_URL=postgres://stampws:${POSTGRES_PASSWORD}@127.0.0.1:5432/stampws
#
# Cloudflare tunnel mode:
# CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
