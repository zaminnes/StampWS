APP_SECRET=replace-with-64-random-characters
LOCAL_DATABASE_URL=sqlite:.data/local.sqlite
LOCAL_SUPERADMIN_PASSWORD=replace-with-super-admin-password
PUBLIC_BASE_URL=https://stampws.kr
STAMP_ALLOWED_ORIGINS=https://stampws.kr
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
LOCAL_DB_POOL_MAX=30

